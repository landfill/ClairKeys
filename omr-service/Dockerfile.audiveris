FROM ubuntu:22.04

ARG AUDIVERIS_VERSION=5.11.0
ARG AUDIVERIS_DEB=Audiveris-5.11.0-ubuntu22.04-x86_64.deb
ARG AUDIVERIS_SHA256=ae714594f40e54b1a4951fc3f914f08ae38fe5d07b7f2283b1a904fdb6e0a318
ARG TESSDATA_REPOSITORY_URL=https://raw.githubusercontent.com/tesseract-ocr/tessdata
ARG TESSDATA_TAG=4.1.0
ARG TESSDATA_ENG_SHA256=daa0c97d651c19fba3b25e81317cd697e9908c8208090c94c3905381c23fc047
ARG OPENJDK_25_URL=https://download.java.net/java/GA/jdk25.0.2/b1e0dfa218384cb9959bdcb897162d4e/10/GPL/openjdk-25.0.2_linux-x64_bin.tar.gz
ARG OPENJDK_25_SHA256=555ce0821e4fe175ea50d54518cd6fbece9663c1998de529bc6ce429534457df
ARG AUDIVERIS_SOURCE_COMMIT=9e1e55cd2746037d059345881c53e6a6754bffbd
ARG LEDGERS_POST_ANALYSIS_SHA256=81202a3d8b10912c132a8340d3de6d6a70782d39cd15e0972410a95212f46f3c
ARG AUGMENTATION_DOT_INTER_SHA256=4741eeafed3105f42e908dcb810eea65d7e41400a305f1a693ed7235dc5fa87b
ARG SLUR_LINKER_SHA256=d9f92f97b42aad8c3763bdae7db35b272b394b2154014c03b665baaf12fbe797
ARG CLUMP_PRUNER_SHA256=0b77cf4e453559b34cfccd9b5f00666f4718ff3d3993f9948e1c58a901dc0d12

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV AUDIVERIS_EXECUTABLE=/opt/audiveris/bin/Audiveris
ENV AUDIVERIS_RECOVERY_EXECUTABLE=/opt/clairkeys-audiveris-recovery/bin/Audiveris
ENV AUDIVERIS_MAX_CONCURRENCY=1
ENV AUDIVERIS_TIMEOUT_SECONDS=900
ENV TESSDATA_PREFIX=/usr/share/tesseract-ocr/4.00/tessdata

# Audiveris's official .deb includes its own jlink JRE. English OCR language
# data is separate from that runtime and must be installed explicitly.
#
# Keep tesseract-ocr-eng because it installs the matching Tesseract packages,
# configuration, and canonical tessdata directory. Ubuntu's packaged English
# model is LSTM-only, however, while Audiveris initializes Tesseract's legacy
# engine. Overwrite only that model with tessdata 4.1.0's 23,466,654-byte
# legacy+LSTM file. Keeping the canonical path also avoids a second shadow
# tessdata directory and lets the existing TESSDATA_PREFIX remain unchanged.
#
# Three needs of the .deb are not expressed by its own metadata:
#   - Its postinst runs xdg-desktop-menu/xdg-mime. Those exit 3 unless a system
#     menu directory exists and desktop-file-utils/shared-mime-info supply the
#     tools they shell out to, which fails `dpkg --configure` for the whole
#     package even though the payload unpacks correctly.
#   - libgtk-3-0 is absent from its Depends, but WellKnowns' static initialiser
#     loads gtk-3 through JNA to read the HiDPI scale before any argument is
#     parsed. Without it every invocation dies with UnsatisfiedLinkError, -batch
#     included.
# The desktop entries themselves are useless in a headless service; they are
# provisioned only so the package configures cleanly.
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-dev \
    curl \
    patch \
    unzip \
    libxml2-dev \
    libxslt1-dev \
    zlib1g-dev \
    tesseract-ocr-eng \
    desktop-file-utils \
    shared-mime-info \
    libgtk-3-0 \
    && mkdir -p /usr/share/applications /usr/share/desktop-directories \
    && curl -fsSL \
      "https://github.com/Audiveris/audiveris/releases/download/${AUDIVERIS_VERSION}/${AUDIVERIS_DEB}" \
      -o "/tmp/${AUDIVERIS_DEB}" \
    && echo "${AUDIVERIS_SHA256}  /tmp/${AUDIVERIS_DEB}" | sha256sum -c - \
    && apt-get install -y --no-install-recommends "/tmp/${AUDIVERIS_DEB}" \
    && curl -fsSL \
      "${TESSDATA_REPOSITORY_URL}/${TESSDATA_TAG}/eng.traineddata" \
      -o /tmp/eng.traineddata \
    && echo "${TESSDATA_ENG_SHA256}  /tmp/eng.traineddata" | sha256sum -c - \
    && install -m 0644 /tmp/eng.traineddata /usr/share/tesseract-ocr/4.00/tessdata/eng.traineddata \
    && sed -i \
      's/java-options=-Xmx8G/java-options=-Xmx3G/' \
      /opt/audiveris/lib/app/Audiveris.cfg \
    && grep -Fqx 'java-options=-Xmx3G' \
      /opt/audiveris/lib/app/Audiveris.cfg \
    && test -x /opt/audiveris/bin/Audiveris \
    && test -x /opt/audiveris/lib/runtime/bin/java \
    && /opt/audiveris/bin/Audiveris -version \
    && rm -f "/tmp/${AUDIVERIS_DEB}" /tmp/eng.traineddata \
    && rm -rf /var/lib/apt/lists/*

# Both installations carry one pinned AugmentationDotInter fix (D-062): a dot
# between two line heads of one chord belongs to the head below it, so the
# order in which that chord's dots are processed cannot drop both dots. They
# also carry one pinned SlurLinker/ClumpPruner fix (D-063): when no slur of a
# clump links heads with the standard coverage, a flat curve ending on a staff
# line is retried with a wider coverage on that end and accepted only as a tie.
# The alternate installation is copied after both fixes, so wedge candidates
# and the selected graph link dots and ties alike, and additionally differs by a pinned
# LedgersPostAnalysis class whose one-pixel upper-height exception requires an
# explicit recovery region.
COPY audiveris-patches/0001-region-scoped-ledger-recovery.patch /tmp/ledger-recovery.patch
COPY audiveris-patches/0002-line-head-dot-link.patch /tmp/dot-link.patch
COPY audiveris-patches/0003-staff-line-tie-head-link.patch /tmp/tie-link.patch
RUN mkdir -p \
      /tmp/jdk25 \
      /tmp/audiveris-source/app/src/main/java/org/audiveris/omr/sheet/ledger \
      /tmp/audiveris-source/app/src/main/java/org/audiveris/omr/sig/inter \
      /tmp/audiveris-source/app/src/main/java/org/audiveris/omr/sheet/curve \
      /tmp/ledger-classes \
      /tmp/dot-classes \
      /tmp/tie-classes \
    && curl -fsSL "${OPENJDK_25_URL}" -o /tmp/openjdk25.tar.gz \
    && echo "${OPENJDK_25_SHA256}  /tmp/openjdk25.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/openjdk25.tar.gz -C /tmp/jdk25 --strip-components=1 \
    && curl -fsSL \
      "https://raw.githubusercontent.com/Audiveris/audiveris/${AUDIVERIS_SOURCE_COMMIT}/app/src/main/java/org/audiveris/omr/sig/inter/AugmentationDotInter.java" \
      -o /tmp/audiveris-source/app/src/main/java/org/audiveris/omr/sig/inter/AugmentationDotInter.java \
    && echo "${AUGMENTATION_DOT_INTER_SHA256}  /tmp/audiveris-source/app/src/main/java/org/audiveris/omr/sig/inter/AugmentationDotInter.java" \
      | sha256sum -c - \
    && sed -i 's/\r$//' \
      /tmp/audiveris-source/app/src/main/java/org/audiveris/omr/sig/inter/AugmentationDotInter.java \
    && patch --directory=/tmp/audiveris-source -p1 --ignore-whitespace \
      --input=/tmp/dot-link.patch \
    && /tmp/jdk25/bin/javac --release 25 -proc:none -sourcepath '' \
      -cp '/opt/audiveris/lib/app/*' -d /tmp/dot-classes \
      /tmp/audiveris-source/app/src/main/java/org/audiveris/omr/sig/inter/AugmentationDotInter.java \
    && /tmp/jdk25/bin/jar --update \
      --file /opt/audiveris/lib/app/audiveris.jar \
      -C /tmp/dot-classes org/audiveris/omr/sig/inter \
    && /tmp/jdk25/bin/jar --list \
      --file /opt/audiveris/lib/app/audiveris.jar \
      | grep -Fqx 'org/audiveris/omr/sig/inter/AugmentationDotInter.class' \
    && curl -fsSL \
      "https://raw.githubusercontent.com/Audiveris/audiveris/${AUDIVERIS_SOURCE_COMMIT}/app/src/main/java/org/audiveris/omr/sheet/curve/SlurLinker.java" \
      -o /tmp/audiveris-source/app/src/main/java/org/audiveris/omr/sheet/curve/SlurLinker.java \
    && curl -fsSL \
      "https://raw.githubusercontent.com/Audiveris/audiveris/${AUDIVERIS_SOURCE_COMMIT}/app/src/main/java/org/audiveris/omr/sheet/curve/ClumpPruner.java" \
      -o /tmp/audiveris-source/app/src/main/java/org/audiveris/omr/sheet/curve/ClumpPruner.java \
    && echo "${SLUR_LINKER_SHA256}  /tmp/audiveris-source/app/src/main/java/org/audiveris/omr/sheet/curve/SlurLinker.java" \
      | sha256sum -c - \
    && echo "${CLUMP_PRUNER_SHA256}  /tmp/audiveris-source/app/src/main/java/org/audiveris/omr/sheet/curve/ClumpPruner.java" \
      | sha256sum -c - \
    && sed -i 's/\r$//' \
      /tmp/audiveris-source/app/src/main/java/org/audiveris/omr/sheet/curve/SlurLinker.java \
      /tmp/audiveris-source/app/src/main/java/org/audiveris/omr/sheet/curve/ClumpPruner.java \
    && patch --directory=/tmp/audiveris-source -p1 --ignore-whitespace \
      --input=/tmp/tie-link.patch \
    && /tmp/jdk25/bin/javac --release 25 -proc:none -sourcepath '' \
      -cp '/opt/audiveris/lib/app/*' -d /tmp/tie-classes \
      /tmp/audiveris-source/app/src/main/java/org/audiveris/omr/sheet/curve/SlurLinker.java \
      /tmp/audiveris-source/app/src/main/java/org/audiveris/omr/sheet/curve/ClumpPruner.java \
    && /tmp/jdk25/bin/jar --update \
      --file /opt/audiveris/lib/app/audiveris.jar \
      -C /tmp/tie-classes org/audiveris/omr/sheet/curve \
    && /tmp/jdk25/bin/jar --list \
      --file /opt/audiveris/lib/app/audiveris.jar \
      | grep -Fqx 'org/audiveris/omr/sheet/curve/SlurLinker.class' \
    && /tmp/jdk25/bin/jar --list \
      --file /opt/audiveris/lib/app/audiveris.jar \
      | grep -Fqx 'org/audiveris/omr/sheet/curve/ClumpPruner$ClumpLinker.class' \
    && curl -fsSL \
      "https://raw.githubusercontent.com/Audiveris/audiveris/${AUDIVERIS_SOURCE_COMMIT}/app/src/main/java/org/audiveris/omr/sheet/ledger/LedgersPostAnalysis.java" \
      -o /tmp/audiveris-source/app/src/main/java/org/audiveris/omr/sheet/ledger/LedgersPostAnalysis.java \
    && echo "${LEDGERS_POST_ANALYSIS_SHA256}  /tmp/audiveris-source/app/src/main/java/org/audiveris/omr/sheet/ledger/LedgersPostAnalysis.java" \
      | sha256sum -c - \
    && sed -i 's/\r$//' \
      /tmp/audiveris-source/app/src/main/java/org/audiveris/omr/sheet/ledger/LedgersPostAnalysis.java \
    && patch --directory=/tmp/audiveris-source -p1 --ignore-whitespace \
      --input=/tmp/ledger-recovery.patch \
    && /tmp/jdk25/bin/javac --release 25 -proc:none -sourcepath '' \
      -cp '/opt/audiveris/lib/app/*' -d /tmp/ledger-classes \
      /tmp/audiveris-source/app/src/main/java/org/audiveris/omr/sheet/ledger/LedgersPostAnalysis.java \
    && cp -a /opt/audiveris /opt/clairkeys-audiveris-recovery \
    && /tmp/jdk25/bin/jar --update \
      --file /opt/clairkeys-audiveris-recovery/lib/app/audiveris.jar \
      -C /tmp/ledger-classes org/audiveris/omr/sheet/ledger \
    && /tmp/jdk25/bin/jar --list \
      --file /opt/clairkeys-audiveris-recovery/lib/app/audiveris.jar \
      | grep -Fqx 'org/audiveris/omr/sheet/ledger/LedgersPostAnalysis.class' \
    && /opt/audiveris/bin/Audiveris -version \
    && /opt/clairkeys-audiveris-recovery/bin/Audiveris -version \
    && rm -rf /tmp/jdk25 /tmp/audiveris-source /tmp/ledger-classes /tmp/dot-classes \
      /tmp/tie-classes /tmp/openjdk25.tar.gz /tmp/ledger-recovery.patch \
      /tmp/dot-link.patch /tmp/tie-link.patch

# Create working directory
WORKDIR /app

# Copy Python requirements first for better Docker layer caching
COPY requirements.txt .
RUN pip3 install --no-cache-dir -r requirements.txt

# Copy application code
COPY . .

# Create directories for processing
RUN mkdir -p /tmp/uploads /tmp/processing /tmp/results /input /output

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Start the application
CMD ["python3", "app.py"]
