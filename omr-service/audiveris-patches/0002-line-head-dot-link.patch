+        // A dot for a head on line lies in the space above that head.
+        // Among line heads, the head below the dot therefore wins, whether it belongs to the
+        // first candidate chord or to another chord (a lower voice sharing the abscissa), and
+        // whatever the order in which dots and chords are processed.
+        // Links are gathered chord by chord, so a head below the dot in the first chord keeps
+        // precedence over one in a later chord.
+        for (Link link : links) {
+            HeadInter head = (HeadInter) link.partner;
+
+            if (head.getCenter().y > dotCenter.y) {
+                return link;
+            }
+        }
+
         return (!links.isEmpty()) ? links.get(0) : null;
     }
 
