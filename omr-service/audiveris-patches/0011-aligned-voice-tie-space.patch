+    private boolean isAlignedOtherVoice (Inter inter,
+                                         HeadInter endHead,
+                                         AbstractChordInter endpoint)
+    {
+        if (!(inter instanceof HeadChordInter other) || !(endpoint instanceof HeadChordInter)
+                || other.getStaff() == null || other.getStaff() != endpoint.getStaff()
+                || other.getStemDir() * endpoint.getStemDir() != -1) {
+            return false;
+        }
+
+        final Rectangle end = endHead.getBounds();
+
+        for (Inter note : other.getNotes()) {
+            final Rectangle box = note.getBounds();
+            final int overlap = Math.min(end.x + end.width, box.x + box.width)
+                    - Math.max(end.x, box.x);
+
+            if (overlap >= constants.minAlignedVoiceOverlap.getValue()
+                    * Math.min(end.width, box.width)) {
+                return true;
+            }
+        }
+
+        return false;
+    }
