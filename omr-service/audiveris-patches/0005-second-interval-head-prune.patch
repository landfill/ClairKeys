+    //-----------------------//
+    // hasDisplacedNeighbor //
+    //-----------------------//
+    /**
+     * Check whether the provided head is the displaced head of a second.
+     * <p>
+     * Two heads a step apart cannot both sit on the same side of their stem, so one of
+     * them is engraved on the other side. This is the shape that
+     * {@link #checkHeadSide(Inter)} already tolerates.
+     * <p>
+     * Only a head exactly one step away counts. A head at the very same pitch on the
+     * other side is a duplicate reading of one notehead, not the other note of a
+     * second, and pruning it is what keeps that note from being emitted twice.
+     *
+     * @param stem     the stem both heads are linked to
+     * @param head     the head found on the unexpected side
+     * @param headSide the side that head was found on
+     * @return true if another head of the same staff sits one step away on the opposite side
+     */
+    private boolean hasDisplacedNeighbor (StemInter stem,
+                                          HeadInter head,
+                                          HorizontalSide headSide)
+    {
+        final Staff staff = head.getStaff();
+
+        if (staff == null) {
+            return false;
+        }
+
+        final HorizontalSide targetSide = headSide.opposite();
+        final int pitch = head.getIntegerPitch();
+
+        return (lookupHead(stem, targetSide, pitch - 1, staff) != null)
+                || (lookupHead(stem, targetSide, pitch + 1, staff) != null);
+    }
+
