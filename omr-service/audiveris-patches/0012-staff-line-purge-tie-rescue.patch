+        double height = 0;
+
+        for (int i = 1; i < 20; i++) {
+            final double t = i / 20.0;
+            final double u = 1 - t;
+            final double x = (u * u * u * curve.getX1()) + (3 * u * u * t * curve.getCtrlX1())
+                    + (3 * u * t * t * curve.getCtrlX2()) + (t * t * t * curve.getX2());
