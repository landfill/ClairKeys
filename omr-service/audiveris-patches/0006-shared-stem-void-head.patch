+    //------------------//
+    // excludeDurations //
+    //------------------//
+    /**
+     * Insert INCOMPATIBLE exclusions between the heads of two duration sets found on
+     * one stem, except between a black head and a void head that stands for another
+     * voice sharing that stem.
+     *
+     * @param set1 heads of one intrinsic duration
+     * @param set2 heads of another intrinsic duration
+     */
+    private void excludeDurations (Set<Inter> set1,
+                                   Set<Inter> set2)
+    {
+        for (Inter i1 : set1) {
+            for (Inter i2 : set2) {
+                if (isSharedStemVoid(i1, i2) || isSharedStemVoid(i2, i1)) {
+                    continue;
+                }
+
+                sig.insertExclusion(i1, i2, INCOMPATIBLE);
+            }
+        }
+    }
+
+    //------------------//
+    // isSharedStemVoid //
+    //------------------//
+    /**
+     * Check whether a void head is a second voice sharing the stem of a black head,
+     * rather than a misreading of that black head's ink.
+     * <p>
+     * Piano scores often write a longer note of a lower voice on the stem of a beamed
+     * group, such as a dotted half under an eighth. Excluding every head of another
+     * duration on a stem then deletes the printed void head whenever the black head
+     * reads slightly better. Most void heads found on a stem are only duplicate
+     * readings of a black notehead, and those overlap it; a printed void head of its
+     * own overlaps no black head and reads as well as a printed notehead does.
+     *
+     * @param candidate the head that may be the shared-stem void head
+     * @param other     the head of another duration on the same stem
+     * @return true if no duration exclusion should link them
+     */
+    private boolean isSharedStemVoid (Inter candidate,
+                                      Inter other)
+    {
+        if ((candidate.getShape() != Shape.NOTEHEAD_VOID)
+                || (other.getShape() != Shape.NOTEHEAD_BLACK)) {
+            return false;
+        }
+
+        if (candidate.getGrade() < constants.minSharedStemVoidGrade.getValue()) {
+            return false;
+        }
+
+        for (Relation rel : sig.getRelations(candidate, Exclusion.class)) {
+            if (((Exclusion) rel).cause != OVERLAP) {
+                continue;
             }
+
+            final Inter opposite = sig.getOppositeInter(candidate, rel);
+
+            if ((opposite != null) && (opposite.getShape() == Shape.NOTEHEAD_BLACK)) {
+                return false; // A duplicate reading of that black notehead
+            }
         }
+
+        if (candidate.isVip() || other.isVip()) {
+            logger.info("VIP no duration exclusion between {} and {}", candidate, other);
+        }
+
+        return true;
     }
 
