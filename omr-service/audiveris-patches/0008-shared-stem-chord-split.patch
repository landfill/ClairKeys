+    /** Separate independently engraved long notes before countDots discards their dots. */
+    private void splitSharedStemChords ()
+    {
+        for (Inter inter : new ArrayList<>(sig.inters(HeadChordInter.class))) {
+            final HeadChordInter chord = (HeadChordInter) inter;
+            final StemInter stem = chord.getStem();
+            if (chord instanceof SmallChordInter || stem == null
+                    || chord.getBeams().isEmpty() || chord.getMembers().size() < 2) {
+                continue;
+            }
+            final List<HeadInter> heads = new ArrayList<>();
+            boolean eligible = true;
+            for (Inter member : chord.getMembers()) {
+                HeadInter head = (HeadInter) member;
+                if (head.getMirror() != null || head.getStaff() != chord.getTopStaff()
+                        || (head.getShape() != Shape.NOTEHEAD_VOID
+                            && head.getShape() != Shape.NOTEHEAD_BLACK)) {
+                    eligible = false;
+                }
+                heads.add(head);
+            }
+            if (!eligible) {
+                continue;
+            }
+            // A chord can be single-staff while its shared beam group crosses staves.
+            final Staff staff = chord.getTopStaff();
+            final BeamGroupInter group = chord.getBeamGroup();
+            if (staff == null || group == null || group.getChords().stream().anyMatch(
+                    sibling -> sibling.getStaves().stream().anyMatch(s -> s != staff))) {
+                continue;
+            }
+            final List<HeadInter> longs = new ArrayList<>();
+            for (HeadInter head : heads) {
+                HeadStemRelation relation = (HeadStemRelation) sig.getRelation(head, stem, HeadStemRelation.class);
+                if (relation == null) {
+                    continue;
+                }
+                if (head.getShape() == Shape.NOTEHEAD_VOID
+                        && heads.stream().anyMatch(h -> h.getShape() == Shape.NOTEHEAD_BLACK)) {
+                    longs.add(head);
+                } else if (head.getShape() == Shape.NOTEHEAD_BLACK && head.getDotCount() == 1) {
+                    HorizontalSide nonCanonical = chord.getStemDir() < 0
+                            ? HorizontalSide.LEFT : HorizontalSide.RIGHT;
+                    if (relation.getHeadSide() != nonCanonical) {
+                        continue;
+                    }
+                    for (HeadInter other : heads) {
+                        HeadStemRelation otherRel = (HeadStemRelation) sig.getRelation(other, stem, HeadStemRelation.class);
+                        if (other.getShape() == Shape.NOTEHEAD_BLACK && other.getDotCount() == 0
+                                && otherRel != null && otherRel.getHeadSide() != nonCanonical
+                                && Math.abs(head.getIntegerPitch() - other.getIntegerPitch()) == 1) {
+                            longs.add(head);
+                            break;
+                        }
+                    }
+                }
+            }
+            if (longs.size() != 1 || longs.size() == heads.size()) {
+                continue;
+            }
+            for (HeadInter head : longs) {
+                HeadChordInter longChord = new HeadChordInter(chord.getGrade());
+                sig.addVertex(longChord);
+                longChord.setStem(stem);
+                longChord.setStaff(head.getStaff());
+                longChord.setStemBeamsExcluded(true);
+                chord.removeMember(head);
+                longChord.addMember(head);
+                chord.getMeasure().addInter(longChord);
+                sig.addEdge(chord, longChord, new SameTimeRelation());
+                logger.info("Shared stem: separated {} from {} into {}", head, chord, longChord);
+            }
+        }
+    }
