+    private boolean isSharedStemSibling (Inter inter, AbstractChordInter endpoint)
+    {
+        if (!(inter instanceof HeadChordInter other)
+                || !(endpoint instanceof HeadChordInter end) || endpoint.getStem() == null
+                || other.getStem() != endpoint.getStem()
+                || !(other.isStemBeamsExcluded() || end.isStemBeamsExcluded())) {
+            return false;
+        }
+        return sig.getRelation(other, endpoint, SameTimeRelation.class) != null
+                || sig.getRelation(endpoint, other, SameTimeRelation.class) != null;
