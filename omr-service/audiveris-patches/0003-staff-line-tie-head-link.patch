+        /**
+         * Select the best tie candidate in clump, using look-up areas widened on slur ends
+         * that lie on a staff line.
+         * <p>
+         * Only candidates linked on both sides to heads that could be tied are considered.
+         *
+         * @return the entry for best tie candidate and its links, or null
+         */
+        public SlurEntry selectStaffLineTie ()
+        {
+            final List<SlurEntry> entries = new ArrayList<>();
+
+            for (Inter inter : clump) {
+                final SlurInter slur = (SlurInter) inter;
+                final Map<HorizontalSide, Area> lineAreas;
+
+                try {
+                    lineAreas = slurLinker.defineStaffLineAreaPair(slur, system);
+                } catch (Exception ignored) {
+                    continue;
+                }
+
+                if (lineAreas == null) {
+                    continue;
+                }
+
+                final Map<HorizontalSide, List<Inter>> lineChords = new EnumMap<>(
+                        HorizontalSide.class);
+
+                for (HorizontalSide side : HorizontalSide.values()) {
+                    lineChords.put(
+                            side,
+                            Inters.intersectedInters(sysChords, null, lineAreas.get(side)
+                                    .getBounds()));
+                }
+
+                final Map<HorizontalSide, SlurHeadLink> linkPair = slurLinker.lookupLinkPair(
+                        slur,
+                        lineAreas,
+                        system,
+                        lineChords);
+
+                if ((linkPair != null) && (linkPair.get(LEFT) != null) && (linkPair.get(
+                        RIGHT) != null) && canBeTie(slur, linkPair)) {
+                    logger.debug("{} staff line tie candidate", slur);
+                    entries.add(new SlurEntry(slur, linkPair));
+                }
+            }
+
+            return selectAmong(entries);
+        }
