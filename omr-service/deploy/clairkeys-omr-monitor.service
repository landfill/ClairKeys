[Unit]
Description=Read-only ClairKeys host resource snapshot

[Service]
Type=oneshot
DynamicUser=yes
StateDirectory=clairkeys-omr-monitor
StateDirectoryMode=0755
ExecStart=/usr/bin/python3 /usr/local/lib/clairkeys-omr/collect-host.py
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
