# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# uploaded files
/uploads/
/public/uploads/

.vercel

# MVP 피아노 모듈
/mvp

# Claude Code local settings
# Declared here since the rule was added, but the file was already tracked, so the
# rule had no effect. Untracked in the same commit that added this note.
.claude/settings.local.json

# Private UI audit captures (issue #146).
# These frames contain the signed-in account's name and library contents, and this
# repository is public, so they can never be committed. The audit's own evidence
# policy says so. Other validation screenshots stay tracked; only this set is private.
docs/recovery/validation/2026-09-07-ui-audit/*.png

# local agent/hook runtime state
/.omx/

# Python bytecode cache (omr-service)
__pycache__/
*.pyc

# Playwright artifacts
/playwright-report/
/test-results/
